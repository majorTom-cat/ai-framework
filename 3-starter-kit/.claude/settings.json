{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Workflow(merge-review)",
      "Workflow(audit-sweep)",
      "Bash(git *)",
      "PowerShell(git *)",
      "PowerShell(npm run *)",
      "PowerShell(npm test*)",
      "PowerShell(npm install)",
      "PowerShell(glab *)",
      "PowerShell(docker compose *)",
      "PowerShell(node --test *)",
      "PowerShell(curl *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm install)",
      "Bash(glab *)",
      "Bash(docker compose *)",
      "Bash(node --test *)",
      "Bash(curl *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(bash scripts/*)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(date *)"
    ],
    "deny": [
      "PowerShell(git push * --force*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "Bash(git push * --force*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push +*)",
      "PowerShell(git push * +*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "PowerShell(git -C * push -f*)",
      "PowerShell(git -C * push --force*)",
      "PowerShell(git -C * push * -f*)",
      "PowerShell(git -C * push * --force*)",
      "PowerShell(git -C * push +*)",
      "PowerShell(git -C * push * +*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push +*)",
      "Bash(git -C * push * +*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)"
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-push.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bundle-guard.cjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "echo '세션 시작: /todo 를 실행해 담당 이슈와 멘션을 브리핑하라.'"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-guard.sh register"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ensure-user-settings.cjs"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo '컨텍스트가 압축되었다. 핵심 규칙 재확인: 남의 모듈 수정 금지 · 공통 영역 변경은 공지 후 · 마무리는 /done 으로만 · 검수요청 전 사용자 화면 확인.'"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-guard.sh register"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "docker *",
      "docker-compose *",
      "glab *",
      "gh *",
      "git *",
      "ssh *",
      "npm *",
      "npx *",
      "node *",
      "bash *",
      "python3 *"
    ],
    "filesystem": {
      "allowWrite": [
        "/private/tmp/claude-501",
        "/tmp/claude-501",
        "/var/folders",
        "/private/var/folders"
      ]
    },
    "network": {
      "allowedDomains": [
        "<사내GitLab주소>",
        "registry.npmjs.org",
        "*.npmjs.org",
        "*.npmjs.com"
      ]
    }
  }
}
